theorem PsT0_eq (f : Fam) :
    psOf (allParts cuts DEN idS 1000 allBC allPD 273 rowCodes lamNum lamDen) f = PsT0 f := by
  rw [psOf_allParts_seg cuts DEN idS 1000 allBC allPD 273 rowCodes lamNum lamDen allBC_length allPD_length
    rowCodes_length lamNum_length _ _ bz_eq rz_eq f]
  simp only [PsT0, segB_append, segR_append, List.append_assoc]

/-- **`IdentityT0` from the three family zeros** (`hdec_of_data` and `identity_of_decomp`). -/
theorem identityT0_of_famZero (hz : ∀ f, FamZero f (PsT0 f)) : IdentityT0 := by
  unfold IdentityT0
  intro μ hμ
  exact identity_of_parts cuts DEN idS 1000 allBC allPD allPD_ok (by rw [allPD_length]) 273 rowCodes lamNum
    lamDen idS_ok idS_pos (fun f => by rw [PsT0_eq]; exact hz f) μ hμ

end LayerDT0

