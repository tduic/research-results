import LayerDProto.R2Kernel

/-!
# Layer D, (E′): the checks of the per-family assembly (core Lean)

A family's functional is a list of parts. A part (`PartData`) is any functional
`F(t) = fac · ⟨B_l X B_rᵀ, ⊗_f ρ_f(t_f)⟩` with integer tables `ρ_f(s)` (24 square matrices per factor,
of any origin: `Gᵀπ` for the d = 5 certificate, scaled site tables for t = 0, or `1 × 1` tables for the
rows and the objective). It carries:

* the fold data of the generators of its subgroup `K` and the listing of `K` (`partStaticOK`);
* per grid value `d` (`PartAtD`): the right-coset representatives, the coset check data, and the chunks
  of `partD` with their claimed values (`partAtDOK`; the `partD` values themselves are separate
  kernel-checked theorems).

`familyAtDOK` checks, for one grid value `d`, that `T = ∑_parts |K| ∑_chunks L` packs the claimed digits
`v` (one per grid point) with digit width `β`, and that both the claimed digits and the true digits
(bounded by `Fbound`) fit the width. -/

namespace LayerDProto

/-- The bosonic groups of families 31 and 13, and of family 22, as index lists. -/
def bosN31 : List Nat := [0, 2, 6, 8, 12, 14]
def bosN22 : List Nat := [0, 1, 6, 7]

/-- The fold data of one generator of `K`. -/
structure FoldDatum where
  κ : KPar
  τ : Bool
  As : List (List (List Int))
  Cs : List (List (List Int))
  als : List Int
  Q : List (List Int)
  R : List (List Int)
  w : Nat

/-- One part of a family's functional. -/
structure PartData where
  ks : List Nat
  k : Nat
  X : List (List Int)
  Bl : List (List Int)
  Br : List (List Int)
  fac : Int
  rhos : List (List (List (List Int)))
  w : Nat
  bnd : Nat
  folds : List FoldDatum
  Ks : List KPar
  tree : List (Nat × Nat)

/-- One part at one grid value. -/
structure PartAtD where
  reps : List KPar
  dec : List (Nat × Nat)
  chunks : List (List MGroup × Int)

/-- The fold checks of one generator (`foldBOK` itself checks `α = ∏_u α_u ≠ 0`). -/
def foldDatumOK (P : PartData) (fd : FoldDatum) : Bool :=
  foldTabOK P.ks P.rhos fd.κ fd.τ fd.As fd.Cs fd.als &&
  foldBOK fd.w P.ks P.k P.X P.Bl P.Br fd.κ fd.τ fd.As fd.Cs fd.als fd.Q fd.R

/-- `K` is generated by checked fold generators; `ks` has four entries and `B_l`, `B_r` rows of length `k`. -/
def partStaticOK (bosL : List Nat) (P : PartData) : Bool :=
  P.ks.length == 4 && P.Bl.all (·.length == P.k) && P.Br.all (·.length == P.k) &&
  closureOK bosL (P.folds.map (·.κ)) P.Ks P.tree && P.folds.all (foldDatumOK P)

/-- The representatives of a list of groups. -/
def repsOf (gs : List MGroup) : List KPar := gs.flatMap fun mg => mg.2.flatMap (·.2)

/-- `cosetOK`, evaluated along `hcodes` (the enumeration is built once, not once per index). -/
def cosetOKz (bosL : List Nat) (Ks reps : List KPar) (dec : List (Nat × Nat)) : Bool :=
  let H := hcodes bosL
  dec.length == H.length && Ks.length * reps.length == H.length && reps.all (parIn bosL) &&
  (H.zip dec).all fun x =>
    decide (x.2.1 < Ks.length) && decide (x.2.2 < reps.length) &&
    mulK (nth Ks x.2.1 ([], false, 0, 0)) (nth reps x.2.2 ([], false, 0, 0)) == x.1

/-- The right cosets, and the chunks cover exactly the representatives (in this order). -/
def partAtDOK (bosL : List Nat) (P : PartData) (Q : PartAtD) : Bool :=
  cosetOKz bosL P.Ks Q.reps Q.dec && Q.chunks.flatMap (fun c => repsOf c.1) == Q.reps

/-- `max_s |ρ_f(s)|`. -/
def tabMax (rhos : List (List (List (List Int)))) (f : Nat) : Nat := maxNat ((nth rhos f []).map entMax)

/-- A bound on `|F(t)|` (without `fac`): `n² · |Y|_max · ∏_f |ρ_f|_max`. -/
def Fbound (P : PartData) : Nat :=
  let n := nth P.ks 0 1 * nth P.ks 1 1 * nth P.ks 2 1 * nth P.ks 3 1
  n * n * (rowSumMax P.Bl * entMax P.X * rowSumMax P.Br) *
    (tabMax P.rhos 0 * tabMax P.rhos 1 * tabMax P.rhos 2 * tabMax P.rhos 3)

/-- `pk`, by halves (the kernel caches every intermediate number; halving keeps them small). -/
def pkB (b : Nat) : Nat → List Int → Int
  | 0, l => pk b l
  | f + 1, l => if l.length ≤ 1 then pk b l else
      pkB b f (l.take (l.length / 2)) + pow2 (b * (l.length / 2)) * pkB b f (l.drop (l.length / 2))

/-- Untrusted balanced digits by halves (only used as data; `familyAtDOK` re-packs them). -/
def unpkB (b : Nat) : Nat → Nat → Int → List Int
  | 0, n, P => unpk b n P
  | f + 1, n, P => if n ≤ 1 then unpk b n P else
      let lo := bal (b * (n / 2)) P
      unpkB b f (n / 2) lo ++ unpkB b f (n - n / 2) ((P - lo) / pow2 (b * (n / 2)))

/-- The packed total of a family at one grid value. -/
def famTotal (parts : List (PartData × PartAtD)) : Int :=
  (parts.map fun x => (x.1.Ks.length : Int) * (x.2.chunks.map (·.2)).foldl (· + ·) 0).foldl (· + ·) 0

/-- The digit bound of a family at one grid value. -/
def famBound (parts : List (PartData × PartAtD)) : Nat :=
  (parts.map fun x => x.1.fac.natAbs * x.1.Ks.length * x.2.reps.length * Fbound x.1).foldl (· + ·) 0

/-- The total packs the claimed digits `v`, and all digits fit the width `β`. -/
def familyAtDOK (β : Nat) (S1 : List Nat) (parts : List (PartData × PartAtD)) (v : List Int) (vb : Nat) : Bool :=
  v.length == 24 * 24 * S1.length && pkB β 20 v == famTotal parts && boundedBy vb v &&
  decide (4 * vb < 2 ^ β) && decide (4 * famBound parts < 2 ^ β)

/-- `familyAtDOK` with zero claimed digits, without building or packing the digit list: the packed total
is `0` and the true digits fit the width (`familyZeroOK_spec`). Measured: the generic check spends about
1 min and 5 GB of kernel cache on packing a 13,824-digit zero list; this one only adds the parts' values. -/
def familyZeroOK (β : Nat) (parts : List (PartData × PartAtD)) : Bool :=
  famTotal parts == 0 && decide (4 * famBound parts < 2 ^ β)

end LayerDProto
