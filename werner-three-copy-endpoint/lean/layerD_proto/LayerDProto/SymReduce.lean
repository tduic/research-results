import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Data.Fintype.Card
import Mathlib.Logic.Equiv.Fintype

/-!
# Layer D, (E′): the `Sym_H` reduction (generic)

The verifier's identity (E) says that the tuple functional `D` of a family sums to zero over every orbit
of the group `H` generated by the orbit generators. Route 2′ checks instead that the symmetrized
functional `Sym D (t) = ∑_{p} D (act p t)` vanishes on a set `R` that meets every orbit. This file
proves, for any finite family of bijections `act : P → Perm T` closed under composition
(`act p ∘ act q = act (mul p q)`, `p ↦ mul p q` bijective):

* `sum_sym_mul`: for `x` invariant under every `act p`,
  `∑_t Sym D t · x t = |P| · ∑_t D t · x t`;
* `sym_act`: `Sym D` is invariant under every `act q`;
* `sym_eq_zero_of_zero_on`: if `Sym D` vanishes on `R` and every `t` has some `act q t ∈ R`, it
  vanishes everywhere;
* `sum_mul_eq_zero_of_sym`: hence `∑_t D t · x t = 0`;
* `sym_eq_card_mul_sum_reps`: if `D` is invariant under every `κ ∈ K` and
  `(κ, r) ↦ mul κ r` is a bijection `K × reps → P`, then `Sym D t = |K| · ∑_{r ∈ reps} D (act r t)`
  (one contraction per coset representative).

Nothing here depends on the Werner data; `SymWerner.lean` instantiates it.
-/

namespace LayerDProto.Sym

open Finset

variable {T P : Type*} [Fintype T] [Fintype P] {S : Type*} [CommRing S]

/-- `Sym D t = ∑_p D (act p t)`. -/
def sym (act : P → Equiv.Perm T) (D : T → S) (t : T) : S := ∑ p, D (act p t)

/-- Averaging against an invariant vector: `∑_t Sym D t · x t = |P| ∑_t D t · x t`. -/
theorem sum_sym_mul (act : P → Equiv.Perm T) (D x : T → S) (hx : ∀ p t, x (act p t) = x t) :
    ∑ t, sym act D t * x t = (Fintype.card P : S) * ∑ t, D t * x t := by
  simp only [sym, Finset.sum_mul]
  rw [Finset.sum_comm]
  have h : ∀ p : P, ∑ t, D (act p t) * x t = ∑ t, D t * x t := by
    intro p
    rw [← Equiv.sum_comp (act p).symm (fun t => D (act p t) * x t)]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [Equiv.apply_symm_apply]
    congr 1
    have := hx p ((act p).symm s)
    rw [Equiv.apply_symm_apply] at this
    exact this.symm
  simp only [h, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

/-- `Sym D` is invariant under the family when it is closed under composition. -/
theorem sym_act (act : P → Equiv.Perm T) (mul : P → P → P)
    (hmul : ∀ p q t, act p (act q t) = act (mul p q) t)
    (hbij : ∀ q, Function.Bijective fun p => mul p q) (D : T → S) (q : P) (t : T) :
    sym act D (act q t) = sym act D t := by
  simp only [sym, hmul]
  exact Equiv.sum_comp (Equiv.ofBijective _ (hbij q)) (fun p => D (act p t))

/-- Vanishing on a set that meets every orbit gives vanishing everywhere. -/
theorem sym_eq_zero_of_zero_on (act : P → Equiv.Perm T) (mul : P → P → P)
    (hmul : ∀ p q t, act p (act q t) = act (mul p q) t)
    (hbij : ∀ q, Function.Bijective fun p => mul p q) (D : T → S) (R : T → Prop)
    (hR : ∀ t, ∃ q, R (act q t)) (h0 : ∀ t, R t → sym act D t = 0) (t : T) :
    sym act D t = 0 := by
  obtain ⟨q, hq⟩ := hR t
  rw [← sym_act act mul hmul hbij D q t]
  exact h0 _ hq

/-- **The reduction used by layer D.** If `Sym D` vanishes on a set meeting every orbit and `x` is
invariant, then `∑_t D t · x t = 0` (over a ring in which `|P|` is not a zero divisor). -/
theorem sum_mul_eq_zero_of_sym [IsDomain S] [CharZero S] (act : P → Equiv.Perm T) (mul : P → P → P)
    (hmul : ∀ p q t, act p (act q t) = act (mul p q) t)
    (hbij : ∀ q, Function.Bijective fun p => mul p q) [Nonempty P] (D x : T → S)
    (hx : ∀ p t, x (act p t) = x t) (R : T → Prop) (hR : ∀ t, ∃ q, R (act q t))
    (h0 : ∀ t, R t → sym act D t = 0) : ∑ t, D t * x t = 0 := by
  have hs := sum_sym_mul act D x hx
  have hz : ∀ t, sym act D t = 0 := sym_eq_zero_of_zero_on act mul hmul hbij D R hR h0
  simp only [hz, zero_mul, Finset.sum_const_zero] at hs
  have hc : (Fintype.card P : S) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  exact (mul_eq_zero.mp hs.symm).resolve_left hc

/-- **Coset decomposition.** If `D` is invariant under every element of `K` and `(κ, r) ↦ mul κ r` is a
bijection from `K × reps` onto `P`, then `Sym D t = |K| ∑_{r ∈ reps} D (act r t)`. -/
theorem sym_eq_card_mul_sum_reps (act : P → Equiv.Perm T) (mul : P → P → P)
    (hmul : ∀ p q t, act p (act q t) = act (mul p q) t) (K reps : Finset P) (D : T → S)
    (hK : ∀ κ ∈ K, ∀ s, D (act κ s) = D s)
    (hdec : Function.Bijective fun x : K × reps => mul x.1.1 x.2.1) (t : T) :
    sym act D t = (K.card : S) * ∑ r ∈ reps, D (act r t) := by
  unfold sym
  rw [← Equiv.sum_comp (Equiv.ofBijective _ hdec) (fun p => D (act p t))]
  simp only [Equiv.ofBijective_apply, ← hmul]
  rw [Fintype.sum_prod_type]
  simp only [fun (κ : K) (r : reps) => hK κ.1 κ.2 (act r.1 t)]
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_coe, nsmul_eq_mul]
  congr 1
  exact Finset.sum_coe_sort reps (fun r => D (act r t))

end LayerDProto.Sym

#print axioms LayerDProto.Sym.sum_sym_mul
#print axioms LayerDProto.Sym.sym_eq_zero_of_zero_on
#print axioms LayerDProto.Sym.sum_mul_eq_zero_of_sym
#print axioms LayerDProto.Sym.sym_eq_card_mul_sum_reps
